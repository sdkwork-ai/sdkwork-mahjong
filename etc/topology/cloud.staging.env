# Bootstrap profile cloud.staging — replace with application-specific values.
SDKWORK_MAHJONG_DEPLOYMENT_PROFILE=cloud
SDKWORK_MAHJONG_ENVIRONMENT=staging
SDKWORK_MAHJONG_PROFILE_ID=cloud.staging
SDKWORK_MAHJONG_APPLICATION_PUBLIC_HTTP_URL=https://mahjong-staging.sdkwork.com
SDKWORK_MAHJONG_PLATFORM_API_GATEWAY_HTTP_URL=https://api-staging.sdkwork.com


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAHJONG_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

