SDKWORK_DEPLOYMENT_PROFILE=standalone
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_demo
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_demo
SDKWORK_DATABASE_USERNAME=sdkwork_ai_demo
SDKWORK_DATABASE_PASSWORD=sdkworkdemo123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10
SDKWORK_MAHJONG_ENVIRONMENT=demo
SDKWORK_MAHJONG_PROFILE_ID=standalone.demo
SDKWORK_MAHJONG_APPLICATION_PUBLIC_HTTP_URL=https://mahjong-demo.sdkwork.com
VITE_SDKWORK_MAHJONG_APPLICATION_PUBLIC_HTTP_URL=https://mahjong-demo.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAHJONG_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_MAHJONG_DEPLOYMENT_PROFILE=standalone
