SDKWORK_DEPLOYMENT_PROFILE=cloud
SDKWORK_CORS_ALLOWED_ORIGINS=https://mahjong.sdkwork.com,https://mahjong.birdcoder.com,https://mahjong.dtupay.com,https://mahjong.noaper.com,https://mahjong.sdkwork.cn,https://mahjong.birdcoder.cn,https://mahjong.dtupay.cn,https://mahjong.noaper.cn,https://mahjong.skubc.com,https://mahjong.skubc.cn,https://mahjong.zowalk.com,https://mahjong.zowalk.cn,https://mahjong.offer86.com,https://mahjong.offer86.cn,https://mahjong.86offer.com,https://mahjong.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=db.example.com
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_prod
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_prod
SDKWORK_DATABASE_USERNAME=sdkwork_ai_prod
SDKWORK_DATABASE_PASSWORD_FILE=/etc/sdkwork/database/database.secret
SDKWORK_DATABASE_SSL_MODE=require
SDKWORK_DATABASE_MAX_CONNECTIONS=20

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAHJONG_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_MAHJONG_ENVIRONMENT=production
SDKWORK_MAHJONG_DEPLOYMENT_PROFILE=cloud
SDKWORK_MAHJONG_PROFILE_ID=cloud.production
