# Bootstrap profile standalone.staging — replace with application-specific values.
SDKWORK_MAHJONG_DEPLOYMENT_PROFILE=standalone
SDKWORK_MAHJONG_ENVIRONMENT=staging
SDKWORK_MAHJONG_PROFILE_ID=standalone.staging
SDKWORK_MAHJONG_APPLICATION_PUBLIC_HTTP_URL=https://mahjong-staging.sdkwork.com
SDKWORK_MAHJONG_APPLICATION_PUBLIC_INGRESS_BIND=127.0.0.1:8080
VITE_SDKWORK_MAHJONG_APPLICATION_PUBLIC_HTTP_URL=http://127.0.0.1:8080


# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAHJONG_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN
