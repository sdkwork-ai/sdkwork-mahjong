SDKWORK_CORS_ALLOWED_ORIGINS=https://mahjong-dev.sdkwork.com,http://mahjong-dev.sdkwork.com,https://mahjong-dev.birdcoder.com,http://mahjong-dev.birdcoder.com,https://mahjong-dev.dtupay.com,http://mahjong-dev.dtupay.com,https://mahjong-dev.noaper.com,http://mahjong-dev.noaper.com,https://mahjong-dev.sdkwork.cn,http://mahjong-dev.sdkwork.cn,https://mahjong-dev.birdcoder.cn,http://mahjong-dev.birdcoder.cn,https://mahjong-dev.dtupay.cn,http://mahjong-dev.dtupay.cn,https://mahjong-dev.noaper.cn,http://mahjong-dev.noaper.cn,https://mahjong-dev.skubc.com,http://mahjong-dev.skubc.com,https://mahjong-dev.skubc.cn,http://mahjong-dev.skubc.cn,https://mahjong-dev.zowalk.com,http://mahjong-dev.zowalk.com,https://mahjong-dev.zowalk.cn,http://mahjong-dev.zowalk.cn,https://mahjong-dev.offer86.com,http://mahjong-dev.offer86.com,https://mahjong-dev.offer86.cn,http://mahjong-dev.offer86.cn,https://mahjong-dev.86offer.com,http://mahjong-dev.86offer.com,https://mahjong-dev.86offer.cn,http://mahjong-dev.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
SDKWORK_RUNTIME_TARGET=browser
SDKWORK_DATABASE_ENGINE=postgresql
SDKWORK_DATABASE_HOST=127.0.0.1
SDKWORK_DATABASE_PORT=5432
SDKWORK_DATABASE_NAME=sdkwork_ai_dev
SDKWORK_DATABASE_SCHEMA=sdkwork_ai_dev
SDKWORK_DATABASE_USERNAME=sdkwork_ai_dev
SDKWORK_DATABASE_PASSWORD=sdkworkdev123
SDKWORK_DATABASE_SSL_MODE=disable
SDKWORK_DATABASE_MAX_CONNECTIONS=10
SDKWORK_MAHJONG_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_MAHJONG_APPLICATION_PUBLIC_HTTP_URL=https://api.sdkwork.com
SDKWORK_MAHJONG_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com
VITE_SDKWORK_MAHJONG_PLATFORM_API_GATEWAY_HTTP_URL=https://api.sdkwork.com

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_MAHJONG_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Canonical profile identity (SOURCE_CONFIG_SPEC.md)
SDKWORK_MAHJONG_ENVIRONMENT=development
SDKWORK_MAHJONG_DEPLOYMENT_PROFILE=cloud
SDKWORK_MAHJONG_PROFILE_ID=cloud.development

# dev:cloud local debugging override (vite dev surface only; PNPM_SCRIPT_SPEC section 3).
# The domain edges above stay authoritative for cloud-mode builds and deployed
# services. The development runtime instead binds every gateway-attached base
# URL to the sdkwork-api-cloud-gateway started by its own dev command
# (bind 127.0.0.1:3900), so dev:cloud quick-starts and debugs against the
# local gateway process.
SDKWORK_LOCAL_PLATFORM_API_GATEWAY_HTTP_URL=http://127.0.0.1:3900
